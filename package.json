{
  "name": "weeqlash",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "type": "module",
  "scripts": {
    "server": "npm run dev --workspace=server",
    "client": "npm start --workspace=client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "npm run tsc:check && eslint server/ client/ tests/",
    "lint:fix": "eslint server/ client/ tests/ --fix",
    "lint:css": "node scripts/check-unused-selectors.js",
    "lint:dead": "knip",
    "lint:all": "npm run lint && npm run lint:css && npm run lint:dead",
    "test:e2e": "playwright test",
    "tsc:check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.11.0",
    "eslint-plugin-html": "^8.2.1",
    "globals": "^17.12.0",
    "knip": "^6.38.0",
    "prettier": "^3.9.9",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "bcrypt": false,
    "fsevents": false,
    "better-sqlite3": false
  }
}
