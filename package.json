{
  "name": "weeqlash",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "type": "module",
  "scripts": {
    "server": "npm run dev --workspace=server",
    "client": "npm start --workspace=client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "npm run tsc:check && eslint server/ client/ tests/",
    "lint:fix": "eslint server/ client/ tests/ --fix",
    "lint:css": "node scripts/check-unused-selectors.js",
    "lint:dead": "knip",
    "lint:all": "npm run lint && npm run lint:css && npm run lint:dead",
    "test:e2e": "playwright test",
    "tsc:check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-html": "^8.2.0",
    "globals": "^17.12.0",
    "knip": "^6.34.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.8"
  }
}
