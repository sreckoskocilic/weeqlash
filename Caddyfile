{
	admin off
}
brawl.weeqlash.icu {
	# SEO headers
	header /* {
		X-Robots-Tag "all"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	@notadmin not path /admin/*
	header @notadmin {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' ws: wss:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}

	# robots.txt
	handle /robots.txt {
		respond * "User-agent: *\nAllow: /\nSitemap: https://brawl.weeqlash.icu/sitemap.xml"
	}

	handle /socket.io/* {
		reverse_proxy localhost:3000
	}
	handle /auth/* {
		reverse_proxy localhost:3000
	}
	handle /admin/* {
		reverse_proxy localhost:3000
	}

	# tacklebox page
	handle_path /tacklebox* {
		root * /opt/tacklebox
		file_server
	}

	@nocache path *.html *.js /
	header @nocache Cache-Control "no-cache, must-revalidate"

	root * /opt/weeqlash/client
	file_server
}
